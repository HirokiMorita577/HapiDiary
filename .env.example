# このファイルを .env にコピーして使う（.env は git 管理しないこと）

# --- AI分類 ---------------------------------------------------------------
# 方式は auto なら「埋め込み(a) → LLM(b) → キーワード(c)」の順に自動選択。
# HAPIDIARY_CLASSIFY_METHOD=auto        # auto / embed / llm / keyword

# (a) 埋め込み近傍検索（推奨）。どちらか一方の鍵を設定 → python genres_build_embeddings.py で
#     genres_embeddings.json を1回作る（記録されたプロバイダを実行時も使う）。
#   Gemini: https://aistudio.google.com/apikey （無料枠・カード登録不要）
GEMINI_API_KEY=
#   Voyage: https://www.voyageai.com/
VOYAGE_API_KEY=
# HAPIDIARY_EMBED_MODEL=              # 未設定なら genres_embeddings.json のモデル
# HAPIDIARY_EMBED_MIN_SCORE=0.42      # 実データを見て調整
# HAPIDIARY_EMBED_KEEP_GAP=0.05

# (b) LLM方式（任意・精度最優先モード）。console.anthropic.com でキー発行。
ANTHROPIC_API_KEY=
# HAPIDIARY_CLASSIFY_MODEL=claude-haiku-4-5    # 投稿確定時
# HAPIDIARY_PREVIEW_MODEL=claude-haiku-4-5     # 書きながら（未設定なら上と同じ）

# (c) キーワード方式は APIキー無しでも動く（部分一致＋漢字の重なり）。
#   さらに MeCab で原形化したい場合のみ:
#     pip install fugashi unidic-lite   ＋   下を 1 にする（辞書がメモリを食う点に注意）
# HAPIDIARY_USE_MECAB=

# --- デバッグ画面 -------------------------------------------------------
# 設定すると /debug がパスワードで開き、分類の利用量・閲覧数などが見える。
# 空なら /debug は 404（機能OFF）。
HAPIDIARY_DEBUG_PASSWORD=

# Flaskのセッション署名鍵（本番では必ずランダムな値に）
HAPIDIARY_SECRET_KEY=happidiary-dev-secret-change-me

# 本番(HTTPS)で 1 にすると、セッションCookieに Secure 属性を付ける（ローカルの http では未設定のまま）
# HAPIDIARY_HTTPS_COOKIE=1

# ログイン名を鍵付きハッシュ化するための鍵（本番では必ずランダムな値に）。
# 未設定なら HAPIDIARY_SECRET_KEY から導出する（開発用フォールバック）。
# ★この鍵を後から変えると既存アカウントのユーザー名照合ができなくなる点に注意。
HAPIDIARY_LOGIN_KEY=

# SQLiteファイルの場所（既定はプロジェクト直下 happidiary.db。Fly.ioでは /data/happidiary.db）
# HAPIDIARY_DB=happidiary.db
